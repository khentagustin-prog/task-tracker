# Supabase (Settings -> API). The publishable key is meant to be public; data is protected by Google sign-in + row level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
# n8n webhook base, used only for reading images with AI (e.g. https://your-n8n/webhook)
VITE_N8N_BASE_URL=
# Optional: allowed email domain for sign-in (default 247ga.co)
# VITE_ALLOWED_DOMAIN=247ga.co
