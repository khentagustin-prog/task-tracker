# Iwanan na blangko para gumamit ng localStorage.
# Kapag nilagay ang n8n webhook base URL, doon na kukuha/magsusulat ng data.
VITE_N8N_BASE_URL=
# Para sa file uploads (publishable key lang, hindi service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Secret na tugma sa Header Auth credential sa n8n (header: x-app-key)
VITE_API_KEY=
